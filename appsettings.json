{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Entra": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "your-domain.com",
    "TenantID": "your-tenantid",
    "ClientId": "your-frontend-clientid",
    "ClientSecret": "your-frontend-secret",
    "Audience": "your-backend-audience",
    "Graph": {
      "AuthMode": "ClientCreds",
      "ClientId": "your-backend-clientid",
      "ClientSecret": "your-backend-secret"
    }
  },
  "KeyVault": {
    "AuthMode": "ClientCreds",
    "VaultUri": "https://your-kv-name.vault.azure.net/",
    "SecretName": "your-backend-clientid"
  }

}
